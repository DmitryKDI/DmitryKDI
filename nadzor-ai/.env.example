# Скопируйте в .env рядом с docker-compose.yml и при необходимости измените.
# Секретов у решения нет: модель локальная, внешних сервисов нет.

# --- Вход в систему (ТЗ 12) ---
# Первый администратор создаётся при первом запуске. Если пароль не задан,
# он генерируется и записывается в /app/state/initial-admin-password.txt.
NADZOR_ADMIN_LOGIN=admin
# NADZOR_ADMIN_PASSWORD=
# 1 — cookie сессии только по HTTPS.
# NADZOR_COOKIE_SECURE=0

# --- Модель ИИ: только локальная, внутри контура ---
# Код отказывается обращаться к адресу вне контура (loopback, частные сети,
# имена сервисов docker compose).
NADZOR_LOCAL_LLM_URL=http://llm:8000
NADZOR_LOCAL_LLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# Каталог весов внутри ./models (для docker compose).
NADZOR_MODEL_DIR=Qwen2.5-VL-7B-Instruct
# Внутренние имена с точкой, которые тоже считаются контуром (через запятую).
# NADZOR_ALLOWED_HOSTS=
# Одновременных вызовов модели: vLLM сам собирает их в пакеты на GPU.
NADZOR_LLM_CONCURRENCY=8
# 0 — не просить у сервера режим JSON (для сервера без response_format).
# NADZOR_LLM_JSON_MODE=1
# Кэш ответов модели для повторной проверки того же комплекта (1/0).
NADZOR_LLM_CACHE=1

# --- Распознавание сканов: Tesseract в образе ---
NADZOR_OCR_LANGUAGE=rus+eng
# TESSDATA_PREFIX=

# --- Проверка по матрице ---
# Сколько параметров матрицы проверяется одним вызовом модели.
# NADZOR_OFFICIAL_BATCH_SIZE=
# Сколько страниц каждой стадии отбирается под один параметр.
# NADZOR_OFFICIAL_PAGES_PER_STAGE=
# Версия набора данных, записываемая в протокол.
# NADZOR_DATASET_VERSION=

# --- Передача результатов во внешнюю систему (ИАИС «РиН») ---
# Пусто — передача выключена: пакет формируется, статус LOCAL_ONLY.
# Задан — POST /api/v1/inspection/{id} отправляет пакет JSON на этот адрес.
# Адрес должен быть внутри контура (имя сервиса, частная сеть или имя из
# NADZOR_ALLOWED_HOSTS), иначе отправка отклоняется (SEND_REFUSED).
# NADZOR_RIN_URL=http://rin-gateway:8080/inbox
# Токен для заголовка Authorization: Bearer (если приёмник его требует).
# NADZOR_RIN_TOKEN=
