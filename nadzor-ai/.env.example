# Скопируйте в .env и заполните. В репозитории значения всегда пустые.
POSTGRES_PASSWORD=
DATABASE_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
# Провайдеры LLM: ключи задаются только через окружение
GIGACHAT_CREDENTIALS=
YANDEX_GPT_API_KEY=
YANDEX_GPT_FOLDER_ID=
ANTHROPIC_API_KEY=
# СУДИР (OIDC)
SUDIR_ISSUER=
SUDIR_CLIENT_ID=
SUDIR_CLIENT_SECRET=
# ИАИС ОГД
IAIS_OGD_BASE_URL=
IAIS_OGD_TOKEN=
# Режим адаптеров: mock | real
IDENTITY_PROVIDER=mock
URBAN_DATA_PROVIDER=mock
