# Скопируйте в .env (без .example) в корне репозитория и заполните нужное.
# ./scripts/start-all.sh подхватывает файл сам при следующем запуске.
POSTGRES_PASSWORD=
DATABASE_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# --- ИИ продукта ---
# Рабочий интерфейс инспектора не содержит выбора модели. Продуктовый дефолт
# в backend — GigaChat-3-Ultra; секрет задаётся только при развёртывании.
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
# Legacy Basic credentials, если используются старые учётные данные.
GIGACHAT_CREDENTIALS=

# Для личного/Freemium API GigaChat официально доступен один одновременный
# поток. Если у вашего корпоративного client_id квота выше, администратор
# может увеличить значение после проверки 429 в логах.
NADZOR_GIGACHAT_CONCURRENCY=1

# Размер текстовой пачки при извлечении требований.
NADZOR_REQUIREMENT_CHUNK_CHARS=18000

NADZOR_MAX_AUTO_ROUTING_ROOMS=8
NADZOR_MAX_VISUAL_REQUIREMENT_FINDINGS=12
NADZOR_MAX_VISUAL_PAGES_PER_FINDING=2
NADZOR_MAX_CONTROL_PAIR_VISION=6
NADZOR_MAX_GRAPHICAL_CANDIDATE_PAIRS=18

# High-recall graphical vision: один ROOM за PASS. PASS 1 получает четыре
# раздельных изображения (общий ПД, ROOM ПД, общий РД, ROOM РД), а PASS 2
# отдельно верифицирует candidate differences. Raster-diff только ранжирует
# кандидатов и больше не блокирует Vision при слабом сигнале.
NADZOR_MAX_FOCUSED_ROOM_VISION_CALLS=36
NADZOR_MAX_FOCUSED_CALLS_PER_PAIR=6
NADZOR_FOCUSED_ROOMS_PER_CALL=1
NADZOR_MAX_FOCUSED_ROOMS_PER_PAIR=20
# Номер помещения — только якорь. ROI расширяется по соседней векторной
# геометрии и с запасом на вводы/выводы через границы помещения.
NADZOR_FOCUSED_CROP_PADDING=0.28
# Отдельные изображения сохраняют тонкие инженерные линии; длинная сторона
# остаётся в рекомендованном GigaChat диапазоне и не превышает 2800 px.
NADZOR_FOCUSED_GENERAL_MAX_DIM=2500
NADZOR_FOCUSED_ROOM_MAX_DIM=2600

# Universal non-room high-recall path. ROOM не обязателен: локальные зоны
# строятся по осевым ячейкам, equipment/system labels и векторной геометрии.
# Если deterministic navigation слабая, PASS0 предлагает только зоны для zoom;
# он не имеет права создавать semantic finding.
NADZOR_MAX_GENERIC_REGION_VISION_CALLS=18
NADZOR_MAX_GENERIC_CALLS_PER_PAIR=4
NADZOR_MAX_GEOMETRY_REGIONS_PER_PAIR=3
NADZOR_MAX_PASS0_REGIONS_PER_PAIR=4
NADZOR_GENERIC_GENERAL_MAX_DIM=2400
NADZOR_GENERIC_LOCAL_MAX_DIM=2600

# Если whole-page vision требования вернул unclear, можно сделать до двух
# повторов на адресных фрагментах вокруг точного номера помещения.
NADZOR_MAX_ROOM_CROP_RETRIES=2

NADZOR_LLM_CACHE=1
# NADZOR_LLM_CACHE_ENTRIES=256
# NADZOR_LLM_PERSISTENT_CACHE_ENTRIES=2048
# NADZOR_LLM_CACHE_DB=

YANDEX_VISION_API_KEY=
YANDEX_FOLDER_ID=
SHEET_NAME_VISION_BUDGET=0

# СУДИР (OIDC)
SUDIR_ISSUER=
SUDIR_CLIENT_ID=
SUDIR_CLIENT_SECRET=
# ИАИС ОГД
IAIS_OGD_BASE_URL=
IAIS_OGD_TOKEN=
IDENTITY_PROVIDER=mock
URBAN_DATA_PROVIDER=mock

# --- НЕОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ ---
