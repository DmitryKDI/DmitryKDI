# Скопируйте в .env (без .example) в корне репозитория и заполните нужное.
# ./scripts/start-all.sh подхватывает файл сам при следующем запуске.
POSTGRES_PASSWORD=
DATABASE_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# --- ИИ продукта ---
# Рабочий интерфейс инспектора не содержит выбора модели. Продуктовый дефолт
# в backend — GigaChat-3-Ultra; секрет задаётся только при развёртывании.
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
# Legacy Basic credentials, если используются старые учётные данные.
GIGACHAT_CREDENTIALS=

# Для личного/Freemium API GigaChat официально доступен один одновременный
# поток. Если у вашего корпоративного client_id квота выше, администратор
# может увеличить значение после проверки 429 в логах.
NADZOR_GIGACHAT_CONCURRENCY=1

# Размер текстовой пачки при извлечении требований. Дефолт кода такой же;
# значение вынесено сюда, чтобы на стенде оно было явно видно.
NADZOR_REQUIREMENT_CHUNK_CHARS=18000

# Точки контроля: сначала формируется узкий список сильных кандидатов, затем
# vision проверяет требования без кода и визуально отличающиеся пары. Кроме
# one-to-one matching используются общие room anchors: одна схема ПД может
# покрывать несколько поэтажных листов РД без benchmark-specific правил.
NADZOR_MAX_AUTO_ROUTING_ROOMS=8
NADZOR_MAX_VISUAL_REQUIREMENT_FINDINGS=12
NADZOR_MAX_VISUAL_PAGES_PER_FINDING=2
NADZOR_MAX_CONTROL_PAIR_VISION=6
# Сколько графических кандидатных пар допускается пропустить через дешёвый
# raster-prefilter. Whole-page LLM имеет отдельный лимит выше, поэтому его
# бюджет больше не обрывает обработку поздних пар.
NADZOR_MAX_GRAPHICAL_CANDIDATE_PAIRS=18

# По рекомендации самого GigaChat focused vision работает по одному ROOM за
# вызов. Перед LLM помещения ранжируются дешёвым локальным raster-score; crop
# дополнительно расширяется примерно на 15%, чтобы не обрезать подключения.
# Глобальный бюджет 24, но одна пара может потратить не более 4 вызовов.
NADZOR_MAX_FOCUSED_ROOM_VISION_CALLS=24
NADZOR_MAX_FOCUSED_CALLS_PER_PAIR=4
NADZOR_FOCUSED_ROOMS_PER_CALL=1
NADZOR_MAX_FOCUSED_ROOMS_PER_PAIR=16
NADZOR_FOCUSED_CROP_PADDING=0.15

# Если whole-page vision требования вернул unclear, можно сделать до двух
# повторов на адресных фрагментах вокруг точного номера помещения. Табличный
# фрагмент не считается доказательством отсутствия инженерного решения.
NADZOR_MAX_ROOM_CROP_RETRIES=2

# Постоянный кэш ответов включён по умолчанию: уже готовые LLM-пачки
# переживают перезапуск сервера и повторно не оплачиваются/не вычисляются.
NADZOR_LLM_CACHE=1
# NADZOR_LLM_CACHE_ENTRIES=256
# NADZOR_LLM_PERSISTENT_CACHE_ENTRIES=2048
# NADZOR_LLM_CACHE_DB=

# Yandex Vision OCR используется для PDF без текстового слоя, если настроен.
YANDEX_VISION_API_KEY=
YANDEX_FOLDER_ID=

# Сколько вызовов модели разрешено потратить на чтение наименований листов
# по изображению штампа за один прогон. По умолчанию 0: дорогой шаг выключен.
SHEET_NAME_VISION_BUDGET=0

# СУДИР (OIDC)
SUDIR_ISSUER=
SUDIR_CLIENT_ID=
SUDIR_CLIENT_SECRET=
# ИАИС ОГД
IAIS_OGD_BASE_URL=
IAIS_OGD_TOKEN=
# Режим адаптеров: mock | real
IDENTITY_PROVIDER=mock
URBAN_DATA_PROVIDER=mock

# --- НЕОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ ---
# Раскомментируйте только то, что действительно переопределяете.

# Пути хранилищ.
# NADZOR_DB_PATH=            # рабочее состояние: прогоны, документы, настройки
# FILE_STORE_DB=             # оригиналы документов (содержимое по SHA-256)
# FILE_STORE_CACHE=          # кэш оригиналов на диске
# FACTS_STORE_DB=            # память разбора страниц по отпечатку содержимого
# KNOWN_VIOLATIONS_PATH=     # реестр наблюдений

# GigaChat: сеть и сертификаты.
# GIGACHAT_OAUTH_URL=
# GIGACHAT_API_BASE=https://api.giga.chat
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_CA_DIR=
# GIGACHAT_CA_BUNDLE=
# NADZOR_SECRETS_DIR=

# Поведение прогонов.
# NADZOR_RESUME_RUNS=        # 0 — не продолжать оборванные прогоны
# NADZOR_LLM_EXTRACTION_MAX_TOKENS=4096
# NADZOR_LLM_TEXT_VERIFY_MAX_TOKENS=4096
# NADZOR_LLM_VISION_MAX_TOKENS=4096

# Служебный fallback для разработчика. В пользовательском интерфейсе
# провайдер/модель не выбираются, основной путь продукта — GigaChat-3-Ultra.
# ANTHROPIC_API_KEY=