# Скопируйте в .env (без .example) в корне репозитория и заполните нужное.
# ./scripts/start-all.sh подхватывает файл сам при следующем запуске.
POSTGRES_PASSWORD=
DATABASE_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
# Провайдеры LLM: ключи задаются только через окружение. Заполнить ключ
# недостаточно — сам провайдер включается на экране «Настройки моделей и
# правил» (кнопка «Сделать основным»), пока он остаётся выключенным по
# умолчанию (mock), даже если ключ уже задан.
# GigaChat 2 про (Client ID + Client Secret)
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
# GigaChat legacy (Basic credentials)
GIGACHAT_CREDENTIALS=
# console.cloud.yandex.ru → Foundation Models → API-ключ; folder ID — из
# адресной строки консоли (b1g...).
YANDEX_GPT_API_KEY=
YANDEX_GPT_FOLDER_ID=
ANTHROPIC_API_KEY=
# Г.99 — сколько вызовов модели разрешено потратить на чтение наименований
# листов по изображению штампа за один прогон. Один вызов на ЛИСТ: у тома рабочей
# документации это порядка сотни обращений, поэтому по умолчанию 0 (шаг
# выключен, состав тома считается без него). Ставится осознанно, тем, кто
# отвечает за бюджет обращений, а не инспектором при нажатии кнопки.
SHEET_NAME_VISION_BUDGET=0
# СУДИР (OIDC)
SUDIR_ISSUER=
SUDIR_CLIENT_ID=
SUDIR_CLIENT_SECRET=
# ИАИС ОГД
IAIS_OGD_BASE_URL=
IAIS_OGD_TOKEN=
# Режим адаптеров: mock | real
IDENTITY_PROVIDER=mock
URBAN_DATA_PROVIDER=mock

# --- НЕОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ ---
# Ниже перечислены имена переменных, которые понимает движок. Все они
# ЗАКОММЕНТИРОВАНЫ намеренно: scripts/start-all.sh экспортирует файл целиком
# (`set -a`), и пустое значение перебило бы значение по умолчанию, зашитое в
# коде. Раскомментируйте строку, только если вписываете в неё значение.

# Пути хранилищ. По умолчанию файлы лежат рядом с проектом; переопределяются
# на стенде, где данные держат отдельно от кода.
# NADZOR_DB_PATH=            # рабочее состояние: прогоны, документы, настройки
# FILE_STORE_DB=             # оригиналы документов (содержимое по SHA-256)
# FILE_STORE_CACHE=          # куда оригинал выкладывается по требованию
# FACTS_STORE_DB=            # память разбора страниц по отпечатку содержимого
# KNOWN_VIOLATIONS_PATH=     # реестр наблюдений, по умолчанию data/known_violations.json

# Провайдер модели: адреса и доверенный набор сертификатов. Значения по
# умолчанию заданы в коде, переопределять нужно только в закрытом контуре.
# GIGACHAT_OAUTH_URL=        # точка авторизации; порт отличается от порта API
# GIGACHAT_API_BASE=         # адрес API
# GIGACHAT_SCOPE=            # область доступа
# GIGACHAT_CA_DIR=           # каталог корневых сертификатов, по умолчанию certs/
# GIGACHAT_CA_BUNDLE=        # готовый файл набора; false отключает проверку TLS
# NADZOR_SECRETS_DIR=        # где искать файл с ключом, по умолчанию secrets/

# Поведение прогонов.
# NADZOR_RESUME_RUNS=        # 0 — не продолжать прогоны, оборванные перезапуском
