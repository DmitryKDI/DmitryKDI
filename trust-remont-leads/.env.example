# Скопируйте этот файл в .env и заполните своими значениями.
# .env никогда не должен попадать в git — он уже добавлен в .gitignore.

# --- Telegram (Telethon, MTProto, вход под личным аккаунтом) ---
# Получить на https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Имя файла сессии Telethon (создастся автоматически при первом запуске)
TELEGRAM_SESSION_NAME=trust_remont_session
# Список ПУБЛИЧНЫХ групп/каналов через запятую: username, ссылка t.me/... или инвайт-ссылка
TELEGRAM_GROUPS=zhk_example_chat,https://t.me/zhk_another_chat
# Сколько последних сообщений проверять за один проход по группе
TELEGRAM_MESSAGE_LIMIT=200

# --- VK (официальный API, метод wall.search) ---
# Токен сообщества или пользователя с правом "wall"
VK_ACCESS_TOKEN=
VK_API_VERSION=5.199
# Список доменов (screen_name) пабликов через запятую, например zhk_example_domain
VK_GROUPS=zhk_example_domain
# Сколько постов запрашивать за один вызов wall.search на одну ключевую фразу
VK_SEARCH_COUNT=50

# --- Форумы ---
# Источники настраиваются в forum_sources.json. Этот флаг просто включает/выключает модуль целиком.
FORUM_ENABLED=true

# --- Хранилище ---
DB_PATH=data/leads.db
CSV_PATH=output/leads.csv
XLSX_PATH=output/leads.xlsx

# --- Режим запуска ---
# once — один проход и выход, loop — бесконечный цикл со встроенной паузой
RUN_MODE=once
RUN_INTERVAL_MINUTES=30
