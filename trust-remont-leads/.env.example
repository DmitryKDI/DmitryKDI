# Скопируйте этот файл в .env и заполните своими значениями.
# Файл .env никогда не должен попадать в git (он уже в .gitignore).

# ---- Telegram ----
# Получить на https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
TG_SESSION_NAME=trust_remont_session
# Юзернеймы или числовые ID чатов для мониторинга сообщений, через запятую
TG_MONITOR_CHATS=
# За сколько часов назад смотреть сообщения при каждом запуске
TG_LOOKBACK_HOURS=24

# ---- VK ----
# Официальный токен пользователя/сообщества с доступом к wall.search
VK_TOKEN=
# screen_name групп/пабликов VK, через запятую (например: zhk_primer,rayon_chat)
VK_GROUPS=
# Поисковые фразы для wall.search, через запятую
VK_SEARCH_QUERIES=ремонт квартиры,ищу бригаду,нужен мастер

# ---- Форумы ----
# URL страниц (разделы/темы/поиск) для парсинга, через запятую.
# Необязательны, если настроен веб-поиск ниже — тогда список URL пополняется
# автоматически найденными страницами.
FORUM_URLS=
# Необязательно: CSS-селектор блоков с сообщениями для конкретного форума
# (если не задан — используется общий эвристический разбор <p>/<div>)
FORUM_SELECTOR=

# ---- Веб-поиск форумов (web_discovery.py) ----
# Официальный Google Custom Search JSON API (НЕ скрейпинг выдачи поисковика —
# это единственный безопасный способ искать по всему интернету, не рискуя
# блокировкой IP). Ключ и Search Engine ID (cx) — на
# https://programmablesearchengine.google.com/ и
# https://console.cloud.google.com/apis/library/customsearch.googleapis.com
# Бесплатный лимит — 100 запросов в день.
SEARCH_API_KEY=
SEARCH_CX=
# Поисковые фразы, через запятую — по ним ищутся новые форумы/страницы
FORUM_SEARCH_QUERIES=форум ремонт квартиры ищу бригаду,ремонт квартиры отзывы кто делал
# Максимум новых URL за один прогон (ограничивает нагрузку и расход квоты)
MAX_DISCOVERED_URLS_PER_RUN=20

# ---- Автопоиск чатов (chat_discovery.py) ----
# Ключевые слова для поиска публичных Telegram-групп/каналов, через запятую.
# Можно указывать как тематические (ремонт, дизайн интерьера), так и по
# конкретным ЖК/районам — chat_discovery.py делает отдельный поиск по каждой фразе.
DISCOVERY_KEYWORDS=ремонт квартир Москва,новостройка ремонт,дизайн интерьера ремонт,ремонт под ключ чат

# ---- Общие настройки ----
KEYWORDS_PATH=keywords.json
DB_PATH=leads.db
# true/false — запускать ли бесконечный цикл со встроенной паузой
LOOP_MODE=false
LOOP_INTERVAL_MINUTES=30
