PORT=4000

# --- Claude API (мозг ассистента) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# --- Слой данных: mock | sqlite | bitrix24 ---
# mock — тестовый набор объектов/сделок/задач в памяти процесса (по умолчанию,
#   для демо-показов); документы тоже в памяти, файлы нигде не сохраняются.
# sqlite — реальная база данных в локальном файле (server/data/app.db) с
#   персистентным хранением объектов/задач/звонков/документов на диске.
#   См. README → "Хранение документов и база данных".
# bitrix24 — реальный Битрикс24 через входящий вебхук (см. README "Как подключить Битрикс24").
DATA_ADAPTER_MODE=mock

# --- SQLite (нужно только при DATA_ADAPTER_MODE=sqlite) ---
# Путь к файлу базы данных. По умолчанию — server/data/app.db (создаётся сам).
SQLITE_DB_PATH=
# Куда сохранять файлы документов (сгенерированные и загруженные вложения).
# По умолчанию — server/uploads/.
UPLOADS_DIR=

# --- Битрикс24 (нужно только при DATA_ADAPTER_MODE=bitrix24) ---
# Входящий вебхук: Битрикс24 → Приложения → Разработчикам → Другое → Входящий вебхук.
# Формат: https://<ваш-портал>.bitrix24.ru/rest/<user_id>/<webhook_code>/
BITRIX24_WEBHOOK_URL=

# --- LPTracker (Этап 5 — звонки; в этой сборке ещё не подключено) ---
LPTRACKER_API_KEY=
