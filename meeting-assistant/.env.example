# Speech-to-text (OpenAI Whisper API)
OPENAI_API_KEY=sk-...

# LLM summarization (Claude API)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# Telegram delivery
# Create a bot via @BotFather to get the token.
TELEGRAM_BOT_TOKEN=123456:ABC-...
# Chat/user/group ID to deliver summaries to. For a personal chat, message
# your bot once, then check https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=123456789

PORT=3000
